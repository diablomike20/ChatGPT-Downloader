      "text": "#!/bin/sh\n\nuci -q batch <<-EOF >/dev/null\n\tdelete ucitrack.@zerotier[-1]\n\tadd ucitrack zerotier\n\tset ucitrack.@zerotier[-1].init=zerotier\n\tcommit ucitrack\nEOF\n\nrm -f /tmp/luci-indexcache\nexit 0\n"
