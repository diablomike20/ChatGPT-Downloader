      "text": "#!/bin/sh  \n\n. /lib/functions.sh\n\nPROG=/usr/bin/zerotier-one\npath=\"$1\"\n\nzerotier_restart() {\n\tlocal ret=1\n\tlocal pid=$(pgrep -x \"$PROG\")\n\t[ -n \"$pid\" ] && {\n\t\tkill -9 \"$pid\"\n\t\tsleep 1\n\t}\n\n\t$PROG $path &\n\tfor i in $(seq 1 30)\n\tdo\n\t\tsleep 1\n\t\tlocal zt=$(ifconfig | grep zt | awk '{print $1}')\n\t\tif [ -n \"$zt\" ]; then\n\t\t\tifconfig \"$zt\" | grep -q 'inet addr'\n\t\t\tif [ $? -eq 0 ]; then\n\t\t\t\tret=0\n\t\t\t\tbreak\n\t\t\tfi\n\t\tfi\n\tdone\n\treturn $ret\n}\n\nzerotier_route() {\n\tlocal dev=\"$1\"\n\tlocal gateway=$(uci -q get zerotier.client.gateway)\n\tlocal policy=$(uci -q get vpn.config.policy)\n\t[ x\"$policy\" = x\"domain\" -o x\"$policy\" = x\"killswitch\" ] && {\n\t\tlocal dnsservers=$(uci -q get vpn.config.dns)\n\t\tfor dnsserver in $dnsservers; do\n\t\t\tip route add $dnsserver/32 dev \"$dev\" via \"$gateway\"\n\t\tdone\n\t}\n\tip route add default dev \"$dev\" via \"$gateway\" table vpn\n\tip route flush cache\n\tuci_set_state vpn config ifname \"$dev\"\n\tfw3 -q reload\n}\n\nwhile true\ndo\n\twhile true\n\tdo\n\t\tubus call pingcheck status | grep -q ONLINE\n\t\t[ $? -eq 0 ] && break\n\t\tsleep 3\n\tdone\n\tzerotier_restart\n\tif [ $? -eq 0 ]; then\n\t\tzt=$(ifconfig | grep zt | awk '{print $1}')\n\t\tif [ x\"$zt\" = x\"$(uci -q get network.vpn.ifname)\" ]; then\n\t\t\t[ x\"$(uci -q get vpn.config.proto)\" = x\"zerotier\" ] && zerotier_route \"$zt\"\n\n\t\t\twhile true\n\t\t\tdo\n\t\t\t\tifconfig \"$zt\" | grep -q 'inet addr'\n\t\t\t\t[ $? -eq 0 ] || break\n\t\t\t\tsleep 10\n\t\t\tdone\n\t\telse\n\t\t\tuci set network.vpn.ifname=\"$zt\"\n\t\t\tuci commit network\n\t\t\tifup vpn\n\t\tfi\n\tfi\ndone\n"
